# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------

POSTGRES_USER=platform
POSTGRES_PASSWORD=platform-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

USER_DB=user_db
ORDER_DB=order_db
PAYMENT_DB=payment_db
NOTIFICATION_DB=notification_db


# --------------------------------------------------
# Internal services
# --------------------------------------------------

USER_SERVICE_URL=http://user-service:8000
ORDER_SERVICE_URL=http://order-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000

# --------------------------------------------------
# AWS / LocalStack
# --------------------------------------------------

AWS_DEFAULT_REGION=eu-west-1

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

AWS_ENDPOINT_URL=http://localstack:4566

PAYMENT_EVENTS_QUEUE_NAME=payment-events
PAYMENT_EVENTS_DLQ_NAME=payment-events-dlq

SQS_WAIT_TIME_SECONDS=10

# Deliberately short for local failure testing.
SQS_VISIBILITY_TIMEOUT_SECONDS=5

# --------------------------------------------------
# Application
# --------------------------------------------------

LOG_LEVEL=INFO
ENVIRONMENT=local